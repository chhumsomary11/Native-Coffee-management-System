# Copy to `.env` next to docker-compose.yaml on each EC2 instance (nano .env).
# The file is IDENTICAL on all three machines except COMPOSE_PROFILES.

# Which services this machine runs: edge | ec2-2 | ec2-3
COMPOSE_PROFILES=edge

# Pull your Docker Hub images instead of using local ones.
IMAGE_PREFIX=danan22/
PULL_POLICY=missing

# PRIVATE IPs of the three instances.
EDGE_IP=10.0.0.1
EC2_2_IP=10.0.0.2
EC2_3_IP=10.0.0.3

# Where each service lives (edge = register, login, nginx, gateway;
# ec2-2 = menu, inventory, order-a, payment; ec2-3 = staff, report, order-b).
REGISTER_HOST=${EDGE_IP}
LOGIN_HOST=${EDGE_IP}
NGINX_HOST=${EDGE_IP}
MENU_HOST=${EC2_2_IP}
INVENTORY_HOST=${EC2_2_IP}
PAYMENT_HOST=${EC2_2_IP}
STAFF_HOST=${EC2_3_IP}
REPORT_HOST=${EC2_3_IP}

# Load-balancer targets used by nginx (order-b is published on 3015).
ORDER_A_HOST=${EC2_2_IP}
ORDER_A_PORT=3005
ORDER_B_HOST=${EC2_3_IP}
ORDER_B_PORT=3015

# --- Secrets shared by all services ---
JWT_SECRETE=change-me
JWT_EXPIRES_IN=1h
INTERNAL_API_KEY=change-me
SERVICE_REQUEST_TIMEOUT_MS=5000

# --- One MongoDB database per service ---
URI_AUTH=mongodb+srv://user:password@cluster.mongodb.net/auth_db
URI_MENU=mongodb+srv://user:password@cluster.mongodb.net/menu_db
URI_INVENTORY=mongodb+srv://user:password@cluster.mongodb.net/inventory_db
URI_ORDER=mongodb+srv://user:password@cluster.mongodb.net/order_db
URI_PAYMENT=mongodb+srv://user:password@cluster.mongodb.net/payment_db
URI_STAFF=mongodb+srv://user:password@cluster.mongodb.net/staff_db

# --- Admin seed (register only) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
